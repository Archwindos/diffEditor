{
  "name": "diffeditor",
  "version": "0.1.7",
  "private": true,
  "description": "Local text review and editing with explicit approval and verified backups",
  "author": "DiffEditor",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts src/renderer/chunks.test.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --win dir --x64",
    "test:e2e": "node scripts/e2e.mjs",
    "test:tray": "node scripts/tray-smoke.cjs"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "iconv-lite": "^0.7.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "local.diffeditor.desktop",
    "productName": "DiffEditor",
    "directories": {
      "output": "release/0.1.7"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**",
      "dist-electron/main.cjs",
      "dist-electron/preload.cjs",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "extraFiles": [
      {
        "from": "dist-electron/cli.cjs",
        "to": "cli.cjs"
      },
      {
        "from": "scripts/portable-cli.cmd",
        "to": "diffeditor.cmd"
      },
      {
        "from": "README.md",
        "to": "使用说明.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "docs/cli.md",
        "to": "docs/cli.md"
      },
      {
        "from": "docs/guide.md",
        "to": "docs/guide.md"
      },
      {
        "from": "docs/images",
        "to": "docs/images"
      },
      {
        "from": "skills/diffeditor",
        "to": "skill/diffeditor"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
